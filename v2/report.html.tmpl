<td>{{range .Locations}}<div class="location"><strong>{{.Role}}</strong>: {{.State}}{{if .Kind}} ({{.Kind}}){{end}}<br>{{range .Context}}<p class="item-context"><strong>{{.Label}}</strong>{{range .Fields}}<br>{{.Label}}: <strong class="pre">{{.Value}}</strong>{{end}}</p>{{end}}<code>{{.Pointer}}</code>{{if or $decision.WholeSchema .CollapseValue}}<details><summary>{{if $decision.WholeSchema}}Schema value{{else}}Configuration value{{end}}</summary><code>{{.Value}}</code></details>{{else}}<p>Value: <code>{{.Value}}</code></p>{{end}}{{if .Artifact}}<details><summary>Artifact</summary><p><code>{{.Artifact}}</code></p><p>ID: <code>{{.ID}}</code></p></details>{{end}}</div>{{end}}{{if .ItemKeys}}<p>Collection item keys (outer to inner):</p><ul>{{range .ItemKeys}}<li><code>{{.}}</code></li>{{end}}</ul>{{end}}</td>
<td>{{if .Normalization}}<p>Normalization: <code>{{.Normalization}}</code></p>{{end}}{{if .ExpectedRole}}<p>Expected ({{.ExpectedRole}}): <code>{{.ExpectedValue}}</code></p>{{end}}{{if .RuleID}}Rule: <code>{{.RuleID}}</code>{{else}}No policy rule applied.{{end}}{{if .Authority}}<p>Authority: {{.Authority}}</p>{{end}}{{if .Replaces}}<p>Replaces: {{.Replaces}}</p>{{end}}
{{if .Evidence}}<details><summary>Evidence</summary><dl>{{range .Evidence}}{{if .Value}}<dt>{{.Name}}</dt><dd class="pre">{{.Value}}</dd>{{end}}{{end}}</dl></details>{{end}}
{{if .Extensions}}<details><summary>Collection mapping extensions</summary><dl>{{range .Extensions}}{{if .Value}}<dt>{{.Name}}</dt><dd class="pre">{{.Value}}</dd>{{end}}{{end}}</dl></details>{{end}}
{{if .ItemScope}}<details><summary>Collection item scope</summary><dl>{{range .ItemScope}}<dt>{{.Name}}</dt><dd class="pre">{{.Value}}</dd>{{end}}</dl></details>{{end}}
{{if .PolicyFiles}}<details><summary>Policy file origin</summary><dl>{{range .PolicyFiles}}<dt>{{.Name}}</dt><dd class="pre">{{.Value}}</dd>{{end}}</dl></details>{{end}}
{{if .Derivation}}<details><summary>Expected result derived from</summary><dl>{{range .Derivation}}<dt>{{.Name}}</dt><dd><code>{{.Value}}</code></dd>{{end}}</dl></details>{{end}}</td></tr>{{end}}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>
:root { color-scheme: light; font-family: system-ui, sans-serif; color: #192f41; background: #f3f6f9; --line: #d7e0e8; --accent: #146782; }
* { box-sizing: border-box; } body { margin: 0; } a { color: #12627f; text-underline-offset: .18em; } a:hover { color: #083b54; } :focus-visible { outline: 3px solid #258aad; outline-offset: 3px; }
.topbar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1.5rem; background: #123348; color: white; min-height: 3.8rem; } .topbar a { color: white; } .mobile-browse { display: none; } .topbar nav { display: flex; flex-wrap: wrap; gap: 1rem; } .brand { font-weight: 650; }
.report-shell { display: grid; grid-template-columns: 19rem minmax(0, 1fr); max-width: 120rem; margin: auto; gap: 1.5rem; padding: 1.5rem; }
.sidebar { position: sticky; top: 5.3rem; align-self: start; max-height: calc(100vh - 6.8rem); overflow: auto; background: white; border: 1px solid var(--line); border-radius: .65rem; }
.navigator-panel > summary { padding: 1rem; font-weight: 650; border-bottom: 1px solid var(--line); } .navigator-body { padding: 0 1rem 1rem; } .navigator-type { margin: .6rem 0; border-top: 1px solid var(--line); } .navigator-type > summary { padding: .8rem .2rem; font-size: .85rem; font-weight: 650; overflow-wrap: anywhere; }
.object-links { list-style: none; padding: 0; margin: 0; } .object-links li { margin: .15rem 0; } .object-links a { display: block; padding: .65rem; border-radius: .35rem; text-decoration: none; overflow-wrap: anywhere; } .object-links a:hover { background: #eef5f9; } .object-links a[aria-current="page"] { background: #e4f2f7; box-shadow: inset 3px 0 var(--accent); color: #0c4259; } .nav-count { display: block; color: #536978; font-size: .75rem; margin-top: .3rem; }
main { min-width: 0; background: white; border: 1px solid var(--line); border-radius: .65rem; padding: 1.75rem; } h1 { font-size: 1.8rem; margin-top: 0; letter-spacing: -.025em; } h2 { margin-top: 2rem; font-size: 1.3rem; } h3 { margin-top: 1.5rem; } h4 { font-size: 1.05rem; } p { line-height: 1.5; } summary { cursor: pointer; } details > summary { line-height: 1.5; }
table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: .9rem; } th, td { padding: .7rem; text-align: left; vertical-align: top; border: 1px solid var(--line); overflow-wrap: anywhere; } th { background: #f0f5f8; font-weight: 600; } caption { text-align: left; font-weight: 650; padding: .5rem 0; }
code { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .85em; } .summary { max-width: 42rem; } .table-wrap { overflow-x: auto; } .overview-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; } .overview-grid h2 { margin-top: 1rem; }
.notice { padding: 1rem; border-left: .25rem solid var(--accent); background: #eef7fa; } .muted { color: #536978; font-size: .85rem; } .badge { display: inline-block; background: #edf2f6; padding: .2rem .45rem; border-radius: .25rem; margin: .1rem; font-size: .8rem; }
.type-index { border: 1px solid var(--line); border-radius: .4rem; margin: .75rem 0; padding: .85rem; } .type-index > summary { font-weight: 650; } .type-index table { margin-bottom: 0; }
.badge[data-status="different"], .badge[data-status="violation"], .badge[data-status="conflict"] { background: #fff0dc; color: #794509; } .badge[data-status="unverified"] { background: #fff4ce; color: #6a5012; } .badge[data-status="equal"], .badge[data-status="equivalent"], .badge[data-status="verified"], .badge[data-status="exception"] { background: #e7f2ed; color: #28543e; }
.report-help { margin: 1rem 0; padding: .75rem; background: #f8fafc; border-radius: .4rem; } .report-help > summary { font-weight: 600; }
details.object-group { border: 1px solid var(--line); border-radius: .4rem; padding: 1rem; margin: 1rem 0; } .object-group > summary { font-size: 1.05rem; } .object-body { margin-top: 1rem; } .finding-section { padding-top: .25rem; }
.object-toolbar { position: sticky; top: var(--header-height, 3.8rem); z-index: 4; padding: .8rem 1rem; background: #f0f6fa; border: 1px solid #c5d9e5; border-radius: .4rem; box-shadow: 0 2px 6px #12334812; } .object-toolbar nav { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; } .object-toolbar strong { display: block; margin: .4rem 0; overflow-wrap: anywhere; } .object-toolbar a { margin-right: auto; }
label { display: block; font-size: .85rem; font-weight: 600; margin: .75rem 0; } input, select, button { font: inherit; padding: .5rem; border: 1px solid #a9bdca; border-radius: .3rem; background: white; color: #193c52; } input, select { display: block; width: 100%; margin-top: .35rem; } button { cursor: pointer; } button:disabled { cursor: default; opacity: .45; } .control-buttons { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .75rem; } .control-buttons button { font-size: .8rem; }
.item-context { border-left: .2rem solid var(--accent); padding: .45rem .7rem; background: #f5fafc; } .location { margin: 0 0 1rem; } .location:last-child { margin-bottom: 0; } .pre { white-space: pre-wrap; } [hidden] { display: none !important; }
.skip-link { position: absolute; left: 1rem; top: -10rem; z-index: 10; padding: .6rem; background: white; } .skip-link:focus { top: .5rem; }
#navigator, #overview, #objects, #diagnostics, #decisions, .object-group, .finding-section { scroll-margin-top: calc(var(--header-height, 3.8rem) + var(--toolbar-height, 0px) + 1rem); }
@media (max-width: 960px) { .mobile-browse { display: inline; } .report-shell { grid-template-columns: 1fr; padding: .75rem; gap: .75rem; } .sidebar { position: static; max-height: none; } .navigator-body { max-height: 65vh; overflow: auto; } .topbar { padding: .7rem 1rem; flex-wrap: wrap; } main { padding: 1rem; } .overview-grid { grid-template-columns: 1fr; gap: 0; } }
@media (max-width: 650px) {
  .object-toolbar nav { display: grid; grid-template-columns: 1fr 1fr; } .object-toolbar a { grid-column: 1 / -1; }
  .finding-section table, .finding-section tbody, .finding-section .decision-row, .finding > tr, .finding > tr > td { display: block; width: 100%; }
  .finding-section thead { display: none; } .finding-section .decision-row { margin: .75rem 0; }
  .finding-section .decision-row > td { display: block; width: 100%; border-bottom: 0; } .finding-section .decision-row > td:last-child { border-bottom: 1px solid var(--line); }
  .finding-section .decision-row > td:nth-child(2)::before { content: "Locations"; display: block; font-weight: 650; margin-bottom: .75rem; }
  .finding-section .decision-row > td:nth-child(3)::before { content: "Policy and provenance"; display: block; font-weight: 650; margin-bottom: .75rem; }
}
@media print { .topbar, .sidebar, .object-toolbar, #empty-selection { display: none !important; } body, main { padding: 0; background: white; } main { border: 0; } .report-shell { display: block; padding: 0; } .table-wrap { overflow: visible; } .overview-grid { display: block; } }
</style>
</head>
<body>
<a class="skip-link" href="#overview">Skip to report</a>
<header class="topbar"><span class="brand">ISC configuration comparison</span><nav aria-label="Report navigation"><a class="mobile-browse" href="#navigator">Browse</a><a href="#overview">Overview</a><a href="#objects">Objects</a><a href="#diagnostics">Diagnostics</a><a href="#decisions">All object details</a></nav></header>
<div class="report-shell">
<aside class="sidebar" id="navigator" tabindex="-1" aria-label="Object navigator">
<details class="navigator-panel" open><summary>Browse and filter</summary><div class="navigator-body">
<div id="controls" hidden>
<label>Search objects, paths or rules <input id="search" type="search" placeholder="Object name, field path, rule…"></label>
<label>Status <select id="status"><option value="">All statuses</option>{{range .Counts}}<option value="{{.Status}}">{{.Status}}</option>{{end}}</select></label>
<label>Section <select id="category"><option value="">All sections</option><option value="connection">Connection settings</option><option value="schemas">Schemas</option><option value="provisioning">Provisioning policies</option><option value="identity-transforms">Identity attribute transforms</option><option value="other">Other settings</option><option value="metadata">Export metadata</option></select></label>
<div class="control-buttons"><button type="button" id="reset">Clear filters</button></div>
<p id="filter-count" class="muted" role="status" aria-live="polite"></p>
<details><summary>Display options</summary><div class="control-buttons"><button type="button" id="expand">Expand visible objects</button><button type="button" id="collapse">Collapse visible objects</button></div><p class="muted">Filters affect navigation and findings, including nested details. Comparison totals remain unchanged.</p></details>
</div>
<nav aria-label="Objects by type">{{range .Types}}<details class="navigator-type" data-type="{{.ID}}"><summary>{{.Type}} <span class="badge type-count">{{len .Groups}} objects</span></summary><ul class="object-links">{{range .Groups}}<li data-group="{{.ID}}"><a href="#{{.ID}}" data-object-link="{{.ID}}">{{.Key}}<span class="nav-count">{{range .Counts}}{{.Status}}: {{.Count}} · {{end}}{{.DecisionCount}} decisions</span></a></li>{{end}}</ul></details>{{else}}<p>No object groups available.</p>{{end}}</nav>
</div></details></aside>
<main id="report-main">
<div id="object-toolbar" class="object-toolbar" hidden><nav aria-label="Object navigation"><a id="back-to-objects" href="#objects">← Back to objects</a><button type="button" id="previous">← Previous</button><button type="button" id="next">Next →</button></nav><strong id="current-object"></strong><span id="object-position" class="muted"></span></div>
<div id="overview" tabindex="-1">
<h1>{{.Title}}</h1>
<p class="notice">{{.Outcome}}</p>
<table class="summary"><caption>Result</caption><tbody>
<tr><th scope="row">Complete</th><td>{{.Complete}}</td></tr><tr><th scope="row">Correct</th><td>{{.Correct}}</td></tr><tr><th scope="row">Exit code</th><td>{{.ExitCode}}</td></tr>
{{if .ObjectKey}}<tr><th scope="row">Object filter</th><td>{{.ObjectType}} &quot;{{.ObjectKey}}&quot;</td></tr>{{end}}
</tbody></table>
<details class="report-help"><summary>How to read this report</summary><p>{{.ValueNotice}} Paths are relative to the decision's <strong>content</strong> payload or <strong>metadata</strong> envelope. A <code>(root)</code> path selects that entire section. Array indices in locations are the original positions in each input; collection item keys explain alignment.</p>
<p>Missing schemas, missing subtrees, and changed transform implementations are shown as grouped findings, with nested decisions available in expandable details. Missing-schema summaries also include informational policy outcomes; explicit assertions and actionable rule checks remain separate. Grouped finding counts describe displayed entries; underlying decision counts retain every comparison decision, including ordinary equal leaves that may be omitted unless --matching is enabled. These counts are not object counts or independent problems.</p>
</details>
<div class="overview-grid"><section><h2>Displayed findings</h2>
{{if .FindingCounts}}<table class="summary"><thead><tr><th scope="col">Status</th><th scope="col">Grouped findings</th></tr></thead><tbody>{{range .FindingCounts}}<tr><td>{{.Status}}</td><td>{{.Count}}</td></tr>{{end}}</tbody></table>{{else}}<p>No findings to display.</p>{{end}}
<p>{{.NestedDecisions}} decisions are nested within the findings below.</p>
</section><section><h2>Decision counts</h2>
{{if .Counts}}<table class="summary"><thead><tr><th scope="col">Status</th><th scope="col">Underlying decisions</th></tr></thead><tbody>{{range .Counts}}<tr><td>{{.Status}}</td><td>{{.Count}}</td></tr>{{end}}</tbody></table>{{else}}<p>No decisions counted.</p>{{end}}
<table class="summary"><caption>Breakdown of different / violation decisions</caption><tbody>
<tr><th scope="row">Object missing</th><td>{{.MissingObjects}}</td></tr><tr><th scope="row">Container presence differs</th><td>{{.ContainerDifferences}}</td></tr><tr><th scope="row">Other field / operation differences</th><td>{{.FieldDifferences}}</td></tr>
</tbody></table>
</section></div>
<details class="report-help"><summary>Inputs, policy and coverage</summary><h2>Inputs and scope</h2>
{{range .Inputs}}<details><summary>{{.Role}} input</summary><table><tbody>{{range .Fields}}{{if .Value}}<tr><th scope="row">{{.Name}}</th><td class="pre">{{.Value}}</td></tr>{{end}}{{end}}</tbody></table></details>{{else}}<p>No input metadata available.</p>{{end}}
<details><summary>Policy and provenance</summary><table><tbody>{{range .Provenance}}{{if .Value}}<tr><th scope="row">{{.Name}}</th><td><code>{{.Value}}</code></td></tr>{{end}}{{end}}</tbody></table></details>
<details><summary>Object coverage</summary><p><code>*_in_scope</code> counts the full selected type inventory. <code>*_outside_object_filter</code> counts objects skipped by <code>--name</code>; <code>*_excluded_by_policy</code> counts objects skipped by policy name lists. <code>compared_groups</code> counts groups reached for comparison; it is separate from decision counts.</p><table><tbody>{{range .Coverage}}<tr><th scope="row">{{.Name}}</th><td>{{.Value}}</td></tr>{{end}}</tbody></table></details>
</details>
<section id="objects" tabindex="-1"><h2>Objects</h2><p id="empty-index" class="notice" hidden>No objects match the current filters. Use Clear filters to restore the list.</p><p class="muted">Expand a configuration type, then select an object. The navigator remains available while you review its findings.</p>
{{range .Types}}<details class="type-index" id="{{.ID}}" data-type="{{.ID}}"><summary>{{.Type}} <span class="badge type-count">{{len .Groups}} objects</span></summary><div class="table-wrap"><table><thead><tr><th scope="col">Object</th><th scope="col">Presence</th><th scope="col">Grouped findings</th><th scope="col">Underlying displayed decisions</th></tr></thead><tbody>{{range .Groups}}<tr data-group="{{.ID}}"><td><a href="#{{.ID}}">{{.Key}}</a></td><td>{{.Presence}}</td><td>{{range .Counts}}<span class="badge" data-status="{{.Status}}">{{.Status}}: {{.Count}}</span>{{else}}No displayed findings{{end}}</td><td>{{.DecisionCount}}</td></tr>{{end}}</tbody></table></div></details>{{else}}<p>No object groups available.</p>{{end}}
</section>
{{if .ExcludedObjects}}<details><summary>Configurations excluded by policy: {{len .ExcludedObjects}}</summary><p>These configurations were not validated. They remain available as matching and reference context.</p><table><thead><tr><th>Type</th><th>Object</th><th>Reason</th></tr></thead><tbody>{{range .ExcludedObjects}}<tr><td>{{.Type}}</td><td>{{.Key}}</td><td>{{.Reason}}</td></tr>{{end}}</tbody></table></details>{{end}}
<section id="diagnostics" tabindex="-1"><h2>Diagnostics</h2>
{{if .Diagnostics}}<table><thead><tr><th scope="col">Diagnostic</th><th scope="col">Rule</th><th scope="col">Type</th><th scope="col">Object</th><th scope="col">Side</th><th scope="col">Required</th></tr></thead><tbody>{{range .Diagnostics}}<tr><td>{{.Code}}</td><td>{{.RuleID}}</td><td>{{.Type}}</td><td>{{.Key}}</td><td>{{.Side}}</td><td>{{.Required}}</td></tr>{{end}}</tbody></table>{{else}}<p>No diagnostics to display.</p>{{end}}
{{if .UnusedOptional}}<details><summary>Unused optional rules: {{.UnusedOptional}}</summary><p>These rules did not apply. They do not by themselves make the comparison incomplete.</p><table><thead><tr><th scope="col">Rule</th><th scope="col">Type</th><th scope="col">Side</th></tr></thead><tbody>{{range .OptionalDiagnostics}}<tr><td>{{.RuleID}}</td><td>{{.Type}}</td><td>{{.Side}}</td></tr>{{end}}</tbody></table></details>{{end}}
</section>
</div>
<section id="detail-view"><h2 id="decisions" tabindex="-1">Decisions</h2>
<p id="empty-selection" class="notice" hidden>No objects match the current filters. Clear the filters or return to the object list.</p>
<noscript><p>Filtering requires JavaScript. All report content remains available through the expandable sections below.</p></noscript>
{{range .Groups}}<details class="object-group" tabindex="-1" id="{{.ID}}" data-search="{{.Type}} {{.Key}}" data-name="{{.Type}} — {{.Key}}">
<summary><strong>{{.Type}} — {{.Key}}</strong> {{range .Counts}}<span class="badge" data-status="{{.Status}}">{{.Status}}: {{.Count}}</span>{{end}}</summary>
<div class="object-body"><p>{{.Presence}}</p><p>{{len .Decisions}} grouped findings representing {{.DecisionCount}} underlying displayed decisions.</p>
{{if .Matching}}<details><summary>Object matching and artifacts</summary><table><tbody>{{range .Matching}}<tr><th scope="row">{{.Name}}</th><td><code>{{.Value}}</code></td></tr>{{end}}</tbody></table></details>{{end}}
{{if .Sections}}<nav aria-label="Report sections">{{range .Sections}}<a class="badge" href="#{{.ID}}">{{.Title}} ({{len .Decisions}})</a> {{end}}</nav>
{{range .Sections}}<section class="finding-section" tabindex="-1" id="{{.ID}}" data-category="{{.Category}}">
<h4>{{.Title}}</h4><p>{{len .Decisions}} grouped findings representing {{.DecisionCount}} underlying displayed decisions. {{range .Counts}}<span class="badge" data-status="{{.Status}}">{{.Status}}: {{.Count}}</span>{{end}}</p>
<div class="table-wrap"><table>{{template "decision-head"}}
{{range .Decisions}}<tbody class="finding" data-category="{{.Category}}" data-status="{{.Status}}" data-statuses="{{.StatusTokens}}" data-decisions="{{.DecisionCount}}">
{{template "decision-row" .}}
{{if .Children}}<tr><td colspan="3"><details class="subtree-details"><summary>{{if .WholeSchema}}Schema details{{else}}Nested decisions{{end}} ({{len .Children}})</summary><p>This finding represents {{.DecisionCount}} underlying decisions, including the parent. {{.ChildrenNotice}}</p>
<table>{{template "decision-head"}}<tbody>{{range .Children}}{{template "decision-row" .}}{{end}}</tbody></table>
</details></td></tr>{{end}}
</tbody>{{end}}</table></div></section>{{end}}{{else}}<p>No displayed decisions for this object. Ordinary equal leaves may be omitted; review the comparison totals and diagnostics.</p>{{end}}
</div></details>{{else}}<p>No decisions to display.</p>{{end}}
</section>
</main></div>
<script>
(function () {
  const groups = Array.from(document.querySelectorAll('.object-group'));
  const search = document.getElementById('search');
  const status = document.getElementById('status');
  const category = document.getElementById('category');
  const overview = document.getElementById('overview');
  const detailView = document.getElementById('detail-view');
  const toolbar = document.getElementById('object-toolbar');
  const previous = document.getElementById('previous');
  const next = document.getElementById('next');
  const rows = groups.flatMap(group => Array.from(group.querySelectorAll('.finding')));
  let selected = null;
  let allDetails = false;
  let filtered = [];
  let lastSelected = null;
  document.getElementById('controls').hidden = false;
  const header = document.querySelector('.topbar');
  function sizeHeader() { document.documentElement.style.setProperty('--header-height', header.getBoundingClientRect().height + 'px'); }
  sizeHeader();
  function sizeToolbar() { document.documentElement.style.setProperty('--toolbar-height', toolbar.hidden ? '0px' : toolbar.getBoundingClientRect().height + 'px'); }
  if (typeof ResizeObserver !== 'undefined') {
    new ResizeObserver(sizeHeader).observe(header);
    new ResizeObserver(sizeToolbar).observe(toolbar);
  }
  else window.addEventListener('resize', sizeHeader);
  if (window.matchMedia('(max-width: 960px)').matches) document.querySelector('.navigator-panel').open = false;
  function paintView() {
    const detailMode = Boolean(selected || allDetails);
    overview.hidden = detailMode;
    detailView.hidden = !detailMode;
    toolbar.hidden = !detailMode;
    groups.forEach(group => {
      group.hidden = !filtered.includes(group) || (!allDetails && group !== selected);
      if (!group.hidden && !allDetails) group.open = true;
    });
    const index = filtered.indexOf(selected);
    previous.disabled = index <= 0;
    next.disabled = index < 0 || index >= filtered.length - 1;
    document.getElementById('current-object').textContent = selected ? selected.dataset.name : 'All object details';
    document.getElementById('object-position').textContent = selected ? (index >= 0 ? 'Object ' + (index + 1) + ' of ' + filtered.length + ' matching objects' : 'This object does not match the current filters.') : filtered.length + ' matching objects';
    const empty = document.getElementById('empty-selection');
    empty.hidden = !detailMode || (selected ? index >= 0 : filtered.length > 0);
    empty.textContent = selected && filtered.length ? 'This object has no findings matching the current filters. Clear the filters or select another object from the navigator.' : 'No objects match the current filters. Clear the filters or return to the object list.';
    document.querySelectorAll('[data-object-link]').forEach(link => {
      if (selected && link.dataset.objectLink === selected.id) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    sizeToolbar();
    if (selected) {
      lastSelected = selected;
      document.getElementById('back-to-objects').href = '#objects';
      const link = document.querySelector('[data-object-link="' + selected.id + '"]');
      if (link) link.closest('.navigator-type').open = true;
    }
  }
  function filter() {
    const query = search.value.trim().toLowerCase();
    let shown = 0, represented = 0;
    filtered = [];
    groups.forEach(group => {
      let visibleRows = 0;
      const groupMatch = group.dataset.search.toLowerCase().includes(query);
      const groupRows = Array.from(group.querySelectorAll('.finding'));
      groupRows.forEach(row => {
        row.hidden = Boolean((category.value && row.dataset.category !== category.value) || (status.value && !row.dataset.statuses.split(' ').includes(status.value)) || (query && !groupMatch && !row.textContent.toLowerCase().includes(query)));
        if (!row.hidden) {
          visibleRows++;
          represented += Number(row.dataset.decisions);
          if ((query && !groupMatch) || (status.value && row.dataset.status !== status.value)) row.querySelectorAll('.subtree-details').forEach(detail => {
            if ((query && detail.textContent.toLowerCase().includes(query)) || status.value) detail.open = true;
          });
        }
      });
      group.querySelectorAll('.finding-section').forEach(section => { section.hidden = !Array.from(section.querySelectorAll('.finding')).some(row => !row.hidden); });
      const matches = groupRows.length ? visibleRows > 0 : !status.value && !category.value && groupMatch;
      if (matches) { filtered.push(group); shown += visibleRows; }
      document.querySelectorAll('[data-group="' + group.id + '"]').forEach(index => { index.hidden = !matches; });
    });
    document.querySelectorAll('[data-type]').forEach(type => {
      const entries = Array.from(type.querySelectorAll('[data-group]'));
      const visible = entries.filter(entry => !entry.hidden).length;
      type.hidden = visible === 0;
      type.querySelector('.type-count').textContent = visible + ' of ' + entries.length + ' objects';
      if (query || status.value || category.value) type.open = visible > 0;
    });
    document.getElementById('filter-count').textContent = shown + ' of ' + rows.length + ' displayed findings representing ' + represented + ' decisions; ' + filtered.length + ' object groups visible.';
    document.getElementById('empty-index').hidden = filtered.length > 0;
    paintView();
  }
  function openAnchor(scroll) {
    let id;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch (_) { id = ''; }
    const target = document.getElementById(id);
    selected = target && (target.classList.contains('object-group') ? target : target.closest('.object-group'));
    allDetails = id === 'decisions';
    paintView();
    if (id === 'navigator') document.querySelector('.navigator-panel').open = true;
    if (id === 'objects' && lastSelected) {
      const entry = document.querySelector('.type-index [data-group="' + lastSelected.id + '"]');
      if (entry) entry.closest('.type-index').open = true;
    }
    if (selected && window.matchMedia('(max-width: 960px)').matches) document.querySelector('.navigator-panel').open = false;
    if (scroll && target) requestAnimationFrame(() => {
      target.scrollIntoView({block: 'start'});
      target.focus({preventScroll: true});
    });
  }
  search.addEventListener('input', filter);
  status.addEventListener('change', filter);
  category.addEventListener('change', filter);
  document.getElementById('reset').addEventListener('click', () => { search.value = ''; status.value = ''; category.value = ''; filter(); });
  document.getElementById('expand').addEventListener('click', () => groups.forEach(group => { if (!group.hidden) group.open = true; }));
  document.getElementById('collapse').addEventListener('click', () => groups.forEach(group => { if (!group.hidden) group.open = false; }));
  previous.addEventListener('click', () => { const i = filtered.indexOf(selected); if (i > 0) location.hash = filtered[i - 1].id; });
  next.addEventListener('click', () => { const i = filtered.indexOf(selected); if (i >= 0 && i < filtered.length - 1) location.hash = filtered[i + 1].id; });
  window.addEventListener('hashchange', () => openAnchor(true));
  document.addEventListener('click', event => {
    const link = event.target.closest('a[href^="#"]');
    if (link && link.hash === location.hash) { event.preventDefault(); openAnchor(true); }
  });
  // Printing includes all matching objects and nested details, then restores the screen view.
  let printState = null;
  window.addEventListener('beforeprint', () => {
    printState = {overview: overview.hidden, detail: detailView.hidden, details: Array.from(document.querySelectorAll('details')).map(node => [node, node.open]), groups: groups.map(node => [node, node.hidden])};
    overview.hidden = false; detailView.hidden = false;
    groups.forEach(group => { group.hidden = !filtered.includes(group); });
    document.querySelectorAll('details').forEach(node => { node.open = true; });
  });
  window.addEventListener('afterprint', () => {
    if (!printState) return;
    overview.hidden = printState.overview; detailView.hidden = printState.detail;
    printState.details.forEach(([node, open]) => { node.open = open; });
    printState.groups.forEach(([node, hidden]) => { node.hidden = hidden; });
    printState = null;
  });
  filter(); openAnchor(Boolean(location.hash));
}());
</script>
</body></html>


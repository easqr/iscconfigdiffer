{
  "id": "isc.common",
  "version": 1,
  "layer": "common",
  "profiles": [
    "isc-identity-v2",
    "isc-envelope-v2",
    "isc-portable-v2"
  ],
  "rules": {
    "version": 2,
    "id": "isc.common",
    "null_handling": "null_equals_absent",
    "identities": [
      {
        "id": "isc.identity.ACCESS_PROFILE",
        "type": "ACCESS_PROFILE",
        "strategy": "fields",

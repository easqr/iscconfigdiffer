        ],
        "component_type": "string"
      },
      {
        "id": "isc.identity.PASSWORD_POLICY",
        "type": "PASSWORD_POLICY",
        "strategy": "fields",
        "paths": [
          "/name"
        ],
        "component_type": "string"
      },
      {
        "id": "isc.identity.PASSWORD_SYNC_GROUP",
        "type": "PASSWORD_SYNC_GROUP",
        "strategy": "fields",
        "paths": [
          "/name"
        ],
        "component_type": "string"
      },
      {
        "id": "isc.identity.PUBLIC_IDENTITIES_CONFIG",
        "type": "PUBLIC_IDENTITIES_CONFIG",

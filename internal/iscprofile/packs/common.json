        ],
        "component_type": "string"
      },
      {
        "id": "isc.identity.ACCESS_REQUEST_CONFIG",
        "type": "ACCESS_REQUEST_CONFIG",
        "strategy": "singleton"
      },
      {
        "id": "isc.identity.AUTH_ORG",
        "type": "AUTH_ORG",
        "strategy": "singleton"
      },
      {
        "id": "isc.identity.NOTIFICATION_TEMPLATE",
        "type": "NOTIFICATION_TEMPLATE",
        "strategy": "fields",
        "paths": [
          "/key",
          "/locale",
          "/medium"
        ],
        "component_type": "string"
      },
      {
        "id": "isc.identity.LIFECYCLE_STATE",
        "type": "LIFECYCLE_STATE",
        "strategy": "dependent",
        "paths": [
          "/technicalName"
        ],
        "component_type": "string",
        "parent_type": "IDENTITY_PROFILE",
        "parent_path": "/identityProfileRef/id"
      },
      {
        "id": "isc.identity.ATTR_SYNC_SOURCE_CONFIG",
        "type": "ATTR_SYNC_SOURCE_CONFIG",
        "strategy": "dependent",
        "parent_type": "SOURCE",
        "parent_path": "/source/id"
      }
    ],
    "expectations": [
      {
        "id": "isc.$TYPE.envelope.version",
        "type": "$TYPE",
        "path": "/version",
        "space": "metadata",
        "modes": [
          "deployment"
        ],
        "operation": "copy_source",
        "authority": "isc-envelope-structure"
      },
      {
        "id": "isc.$TYPE.envelope.self.type",
        "type": "$TYPE",
        "path": "/self/type",
        "space": "metadata",
        "modes": [
          "deployment"
        ],
        "operation": "copy_source",
        "authority": "isc-envelope-structure"
      }
    ]
  }

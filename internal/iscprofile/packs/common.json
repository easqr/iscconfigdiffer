        "component_type": "string"
      },
      {
        "id": "isc.identity.TAG",
        "type": "TAG",
        "strategy": "fields",
        "paths": [
          "/name"
        ],
        "component_type": "string"
      },
      {
        "id": "isc.identity.TRANSFORM",
        "type": "TRANSFORM",
        "strategy": "fields",
        "paths": [
          "/name"
        ],
        "component_type": "string"
      },
      {
        "id": "isc.identity.TRIGGER_SUBSCRIPTION",
        "type": "TRIGGER_SUBSCRIPTION",
        "strategy": "fields",
        "paths": [
          "/name"
        ],
        "component_type": "string"
      },
      {
        "id": "isc.identity.WORKFLOW",
        "type": "WORKFLOW",

{
  "id": "isc.microsoft-entra",
  "version": 1,
  "layer": "connector",
  "profiles": [
    "isc-identity-v2",
    "isc-envelope-v2",
    "isc-portable-v2"
  ],
  "rules": {
    "version": 2,
    "id": "isc.microsoft-entra",
    "collections": [
      {
        "id": "isc.SOURCE.entra-skus",
        "type": "SOURCE",
        "path": "/connectorAttributes/subscribedSkus",
        "variant": "microsoft-entra",
        "mode": "keyed",
        "keys": [
          "/skuId"
        ],
        "item_label": "SKU",
        "display_fields": [
          {
            "label": "SKU ID",
            "path": "/skuId"
          },
          {
            "label": "Part number",
            "path": "/skuPartNumber"
          }
        ]
      },
      {
        "id": "isc.SOURCE.entra-service-plans",
        "type": "SOURCE",
        "path": "/connectorAttributes/subscribedSkus/*/servicePlans",
        "variant": "microsoft-entra",
        "mode": "keyed",
        "keys": [
          "/servicePlanId"
        ],
        "item_label": "Service plan",
        "display_fields": [
          {
            "label": "Service plan ID",
            "path": "/servicePlanId"
          },
          {
            "label": "Name",
            "path": "/servicePlanName"
          }
        ]
      }
    ]
  },
  "connector": {
    "variant": "microsoft-entra",
    "identifiers": [
      {
        "path": "/connectorAttributes/connectorName",
        "values": [
          "Microsoft Entra"
        ]
      }
    ]
  }
}

{
  "id": "isc.identity-object-config",
  "version": 1,
  "layer": "type",
  "profiles": ["isc-identity-v2", "isc-envelope-v2", "isc-portable-v2"],
  "rules": {
    "version": 2,
    "id": "isc.identity-object-config",
    "collections": [
      {
        "id": "isc.IDENTITY_OBJECT_CONFIG.object-attribute-details",
        "type": "IDENTITY_OBJECT_CONFIG",
        "path": "/objectAttributeDetails",
        "mode": "keyed",
        "keys": ["/name"],
        "component_type": "string",
        "item_label": "Identity attribute",
        "display_fields": [{"label": "Name", "path": "/name"}]
      },
      {
        "id": "isc.IDENTITY_OBJECT_CONFIG.attribute-source-priority",
        "type": "IDENTITY_OBJECT_CONFIG",
        "path": "/objectAttributeDetails/*/attributeSources",
        "mode": "keyed",
        "keys": ["/applicationRef/name"],
        "component_type": "string",
        "item_label": "Attribute source",
        "display_fields": [{"label": "Application", "path": "/applicationRef/name"}],
        "priority_order": {
          "type": "IDENTITY_PROFILE",
          "reference_path": "/applicationRef/id",
          "match_path": "/authoritativeSource/id",
          "priority_path": "/priority"
        }
      }
    ],
    "ignores": [
      {
        "id": "isc.IDENTITY_OBJECT_CONFIG.attribute-source-rule-id",
        "type": "IDENTITY_OBJECT_CONFIG",
        "path": "/objectAttributeDetails/*/attributeSources/*/ruleRef/id"
      },
      {
        "id": "isc.IDENTITY_OBJECT_CONFIG.attribute-source-application-id",
        "type": "IDENTITY_OBJECT_CONFIG",
        "path": "/objectAttributeDetails/*/attributeSources/*/applicationRef/id"
      }
    ]
  }
}

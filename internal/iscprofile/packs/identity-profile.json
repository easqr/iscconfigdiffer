{
  "id": "isc.identity-profile",
  "version": 1,
  "layer": "type",
  "profiles": ["isc-identity-v2", "isc-envelope-v2", "isc-portable-v2"],
  "rules": {
    "version": 2,
    "id": "isc.identity-profile",
    "collections": [
      {
        "id": "isc.IDENTITY_PROFILE.attribute-transforms",
        "type": "IDENTITY_PROFILE",
        "path": "/identityAttributeConfig/attributeTransforms",
        "mode": "keyed",
        "keys": ["/identityAttributeName"],
        "component_type": "string",
        "item_label": "Identity attribute transform",
        "display_fields": [{"label": "Identity attribute", "path": "/identityAttributeName"}]
      }
    ],
    "ignores": [
      {
        "id": "isc.IDENTITY_PROFILE.attribute-transform-source-id",
        "type": "IDENTITY_PROFILE",
        "path": "/identityAttributeConfig/attributeTransforms/*/transformDefinition/attributes/sourceId"
      },
      {
        "id": "isc.IDENTITY_PROFILE.attribute-transform-input-source-id",
        "type": "IDENTITY_PROFILE",
        "path": "/identityAttributeConfig/attributeTransforms/*/transformDefinition/attributes/input/attributes/sourceId"
      }
    ],
    "equivalences": [
      {
        "id": "isc.IDENTITY_PROFILE.priority-order",
        "type": "IDENTITY_PROFILE",
        "path": "/priority",
        "operation": "relative_order"
      }
    ]
  }
}
